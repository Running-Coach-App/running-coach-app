# Running Coach App
# Copy this file to .env only if you add a local override.
# The current Android build reads no variables from .env.
# The Android SDK location belongs in local.properties as sdk.dir.
# local.properties is not committed.
#
# University VM. Fill these on a campus machine. Do not commit real values.
# Staging and production are separate ports on the same VM.
VM_HOST=
VM_USER=
STAGING_PORT=
PRODUCTION_PORT=
STAGING_URL=
PRODUCTION_URL=
STAGING_APK_PATH=
PRODUCTION_APK_PATH=
