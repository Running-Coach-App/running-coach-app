<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RunningCoach" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_default</item>
        <item name="colorPrimaryDark">@color/accent_default</item>
        <item name="colorAccent">@color/accent_default</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="buttonStyle">@style/Widget.RunningCoach.Button.Primary</item>
        <item name="editTextStyle">@style/Widget.RunningCoach.Field</item>
    </style>

    <style name="Theme.RunningCoach.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.RunningCoach</item>
    </style>

    <style name="Widget.RunningCoach.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.RunningCoach.Button.Secondary" parent="Widget.RunningCoach.Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/accent_default</item>
    </style>

    <style name="Widget.RunningCoach.Button.Stop" parent="Widget.RunningCoach.Button.Primary">
        <item name="android:background">@drawable/bg_button_stop</item>
        <item name="android:textColor">@color/status_danger</item>
    </style>

    <style name="Widget.RunningCoach.Button.Tab" parent="Widget.AppCompat.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.RunningCoach.Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
