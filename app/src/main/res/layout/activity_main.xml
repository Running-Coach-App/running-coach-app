<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/pocketNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pocket_note" />

    <Button
        android:id="@+id/startInterval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_interval" />

    <Button
        android:id="@+id/startSteady"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_steady" />

    <Button
        android:id="@+id/stopSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop_session" />

    <EditText
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/question_hint"
        android:inputType="text" />

    <Button
        android:id="@+id/ask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ask" />
</LinearLayout>
