<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/viewRun"
            layout="@layout/view_run" />

        <include
            android:id="@+id/viewHistory"
            layout="@layout/view_history"
            android:visibility="gone" />

        <include
            android:id="@+id/viewReport"
            layout="@layout/view_report"
            android:visibility="gone" />

        <include
            android:id="@+id/viewProfile"
            layout="@layout/view_profile"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tab_bar"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabRun"
            style="@style/Widget.RunningCoach.Button.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_run" />

        <Button
            android:id="@+id/tabHistory"
            style="@style/Widget.RunningCoach.Button.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_history" />

        <Button
            android:id="@+id/tabProfile"
            style="@style/Widget.RunningCoach.Button.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_profile" />
    </LinearLayout>
</LinearLayout>
