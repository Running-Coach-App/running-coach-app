<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:clipChildren="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24">

        <TextView
            android:id="@+id/sessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_idle"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pocketNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/pocket_note"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stats_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_label_time"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/statTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/stat_idle_time"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_label_pace"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/statPace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/stat_idle_pace"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_stat"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_label_distance"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/statDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/stat_idle_distance"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_stat"
                    android:textStyle="bold" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/coachSpeakPopup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/spacing_16"
                android:background="@drawable/bg_speak_popup"
                android:elevation="@dimen/spacing_16"
                android:minHeight="@dimen/speak_popup_min"
                android:orientation="vertical"
                android:outlineProvider="background"
                android:padding="@dimen/spacing_16"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/coach_said_label"
                        android:textColor="@color/accent_default"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/coachPopupTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_idle_time"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_stat"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/coachLive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/coachSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <app.runningcoach.CoachOrbView
                android:id="@+id/coachOrb"
                android:layout_width="match_parent"
                android:layout_height="@dimen/orb_size" />

            <TextView
                android:id="@+id/coachPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center"
                android:textColor="@color/accent_default"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/locationWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/location_warning"
            android:textColor="@color/status_danger"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <Button
            android:id="@+id/startInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/start_interval" />

        <Button
            android:id="@+id/startSteady"
            style="@style/Widget.RunningCoach.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/start_steady" />

        <Button
            android:id="@+id/stopSession"
            style="@style/Widget.RunningCoach.Button.Stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/stop_session" />

        <EditText
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:hint="@string/question_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/ask"
            style="@style/Widget.RunningCoach.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/ask" />
    </LinearLayout>
</ScrollView>
